# ─── Backend API ─────────────────────────────────────────────────────────────
# Base URL for all REST API calls. In development you can use the Vite proxy
# (leave blank or omit), or point directly at your backend server.
# In production set this to your deployed API origin, e.g.:
#   VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# No JWT secret is needed on the frontend — the server signs tokens.
# The client reads the token from the login response and stores it in
# localStorage under the key "exam_portal_token".

# ─── Google Gemini AI (PDF-to-MCQ feature) ────────────────────────────────────
# Required for the interviewer PDF question generation feature.
# Injected automatically by Google AI Studio at runtime.
GEMINI_API_KEY=

# ─── App / Hosting ────────────────────────────────────────────────────────────
# Public URL where this app is hosted. Used for OAuth callbacks / deep links.
APP_URL=
